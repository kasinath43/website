pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                echo 'Building Abode Software production image'

                sh '''
                    docker build -t abode-webapp-prod:${BUILD_NUMBER} .
                '''
            }
        }

        stage('Test') {
            steps {
                echo 'Testing production image'

                sh '''
                    docker network inspect abode-ci >/dev/null 2>&1 || docker network create abode-ci

                    docker network connect abode-ci jenkins 2>/dev/null || true

                    docker rm -f abode-prod-test 2>/dev/null || true

                    docker run -d \
                        --name abode-prod-test \
                        --network abode-ci \
                        abode-webapp-prod:${BUILD_NUMBER}

                    trap 'docker rm -f abode-prod-test 2>/dev/null || true' EXIT

                    sleep 5

                    docker exec jenkins curl -fsS http://abode-prod-test

                    echo "Production image test passed!"
                '''
            }
        }

        stage('Production Deployment') {
            steps {
                echo 'Deploying Abode Software to production'

                sh '''
                    docker network inspect abode-ci >/dev/null 2>&1 || docker network create abode-ci

                    docker rm -f abode-webapp-container 2>/dev/null || true

                    docker run -d \
                        --name abode-webapp-container \
                        --network abode-ci \
                        --restart unless-stopped \
                        -p 8080:80 \
                        abode-webapp-prod:${BUILD_NUMBER}

                    sleep 5

                    docker exec jenkins curl -fsS http://abode-webapp-container

                    echo "Production website is healthy!"
                '''
            }
        }
    }

    post {
        success {
            echo 'Production deployment successful!'
        }

        failure {
            echo 'Production deployment failed! Check Console Output.'
        }
    }
}
